#!/usr/bin/env bash
set -eou pipefail

NEED_POP=0
if ! git diff --quiet || ! git diff --quiet -- .; then
    NEED_POP=1
    git stash push -q --keep-index --include-untracked -m precommit-format
fi

readarray -d '' files < <(
    git diff --cached --name-only -z --diff-filter=ACM \
    | grep -zE '\.py$' \
    | grep -zEv '^(llvm-project/|external/llvm-project/)'
)

if (( ${#files[@]} )); then
    if command -v yapf >/dev/null 2>&1; then
        echo "Running yapf on ${#files[@]} files..."
        yapf -i "${files[@]}"
        echo "Staging changes..."
        git add -- "${files[@]}"
    else
        echo "yapf not found, skipping Python formatting."
    fi
fi

echo "Running clang-format on C/C++ files..."
cd "$(git rev-parse --show-toplevel)"
python3 mlir/utils/widgets/clangformat.py -q -i HEAD

if (( NEED_POP )); then
    git stash pop -q || true
fi

exit 0
