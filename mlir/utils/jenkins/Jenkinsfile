                                                        showEnv()
                                                        // Package and install current checkout of rocMLIR as MIGraphX dependency (builds the fat lib, can OOM).
                                                        shStrict 'cget -p ${WORKSPACE}/MIGraphXDeps install ${WORKSPACE} -DBUILD_FAT_LIBROCKCOMPILER=On -DCMAKE_CXX_COMPILER=/opt/rocm/llvm/bin/clang++ -DCMAKE_C_COMPILER=/opt/rocm/llvm/bin/clang'
                                                    }

