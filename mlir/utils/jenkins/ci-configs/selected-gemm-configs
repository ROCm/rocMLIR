-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 1 -n 768 -k 768
# Scaled GEMM (FP4 with f8E8M0FNU scales). Exercises the new natural-form
# scale path end-to-end (rocmlir-gen --broadcastScales=false default,
# `compactBroadcastedScale`/`broadcastScaleAlongK` view chains, and
# `amdgpu.scaled_mfma`). gfx950+ only; configs are no-ops on other archs
# because the verifier rejects scaled GEMM there.
-t f4E2M1FN -out_datatype f32 -transA false -transB false -g 1 -m 4096 -n 4096 -k 4096 -scaledGemm -scale_a_dtype f8E8M0FNU -scale_b_dtype f8E8M0FNU
-t f4E2M1FN -out_datatype f32 -transA false -transB true  -g 1 -m 8192 -n 1024 -k 4096 -scaledGemm -scale_a_dtype f8E8M0FNU -scale_b_dtype f8E8M0FNU
-t f4E2M1FN -out_datatype f32 -transA true  -transB false -g 1 -m 1024 -n 8192 -k 4096 -scaledGemm -scale_a_dtype f8E8M0FNU -scale_b_dtype f8E8M0FNU
