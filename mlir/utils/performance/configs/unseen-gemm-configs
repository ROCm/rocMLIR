# unseen-gemm-configs -- curated GEMM problems deliberately NOT present in
# tier1-gemm-configs, used to measure generalization to never-encountered
# problems (e.g. quick-tuning / ML-classifier coverage on out-of-distribution
# shapes). Each line is fully specified (-t, -out_datatype, -transA, -transB)
# so it maps to exactly one problem with no combinatorial expansion.
# Lines starting with '#' and blank lines are ignored by the config loader.

# --- bf16: an entirely unseen datatype (tier1 has only f32/f16/i8) ---
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 2048 -n 2048 -k 2048
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 4096 -n 11008 -k 4096
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 1024 -n 4096 -k 4096
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 8192 -n 8192 -k 8192
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 512 -n 512 -k 512
-t bf16 -out_datatype bf16 -transA false -transB true -g 1 -m 2048 -n 8192 -k 2048
-t bf16 -out_datatype bf16 -transA false -transB true -g 1 -m 1 -n 8192 -k 2048
-t bf16 -out_datatype bf16 -transA true -transB false -g 1 -m 2048 -n 2048 -k 8192
-t bf16 -out_datatype bf16 -transA false -transB false -g 8 -m 512 -n 512 -k 512
-t bf16 -out_datatype bf16 -transA false -transB false -g 1 -m 1 -n 4096 -k 4096

# --- square power-of-two GEMMs absent from tier1 ---
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 1024 -n 1024 -k 1024
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 2048 -n 2048 -k 2048
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 3072 -n 3072 -k 3072
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 8192 -n 8192 -k 8192
-t f32 -out_datatype f32 -transA false -transB false -g 1 -m 2048 -n 2048 -k 2048
-t f32 -out_datatype f32 -transA false -transB false -g 1 -m 8192 -n 8192 -k 8192
-t i8 -out_datatype i32 -transA false -transB false -g 1 -m 1024 -n 1024 -k 1024
-t i8 -out_datatype i32 -transA false -transB false -g 1 -m 2048 -n 2048 -k 2048

# --- transA=true & transB=true (TT) -- a transpose combo tier1 never uses ---
-t f16 -out_datatype f16 -transA true -transB true -g 1 -m 2048 -n 2048 -k 2048
-t f32 -out_datatype f32 -transA true -transB true -g 1 -m 1024 -n 1024 -k 1024
-t i8 -out_datatype i32 -transA true -transB true -g 1 -m 2048 -n 2048 -k 2048

# --- extreme aspect ratios with fresh dimensions ---
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 16384 -n 128 -k 4096
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 128 -n 16384 -k 4096
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 64 -n 64 -k 16384
-t f32 -out_datatype f32 -transA false -transB false -g 1 -m 32768 -n 256 -k 256
-t f16 -out_datatype f16 -transA false -transB true -g 1 -m 1 -n 65536 -k 2048

# --- non-power-of-two / unaligned shapes to stress generalization ---
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 129 -n 2049 -k 513
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 333 -n 777 -k 999
-t f32 -out_datatype f32 -transA false -transB false -g 1 -m 255 -n 257 -k 259
-t i8 -out_datatype i32 -transA false -transB false -g 1 -m 300 -n 600 -k 900

# --- batched (grouped) GEMMs with unseen group counts ---
-t f16 -out_datatype f16 -transA false -transB false -g 8 -m 512 -n 1024 -k 1024
-t f16 -out_datatype f16 -transA false -transB false -g 48 -m 128 -n 128 -k 128
-t f16 -out_datatype f16 -transA false -transB true -g 96 -m 64 -n 64 -k 128
-t f32 -out_datatype f32 -transA false -transB false -g 4 -m 1024 -n 1024 -k 1024

# --- decode / small-batch inference with fresh N,K ---
-t f16 -out_datatype f16 -transA false -transB false -g 1 -m 1 -n 2048 -k 2048
-t f16 -out_datatype f16 -transA false -transB true -g 1 -m 1 -n 16384 -k 2048
-t f32 -out_datatype f32 -transA false -transB false -g 1 -m 1 -n 2048 -k 2048
-t i8 -out_datatype i32 -transA false -transB false -g 1 -m 1 -n 2048 -k 2048
